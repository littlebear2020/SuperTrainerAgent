# === CRITICAL: dev runtime data — agent threads, generated video/audio, SQLite ===
# NEVER include in any image (server has its own .deer-flow volume mount).
# Excluding this keeps the build context ~1GB instead of ~180GB.
backend/.deer-flow/
.deer-flow/
**/.deer-flow/


# 本地探针/临时脚本（git status ?? 里的 backend/temp_*）——不入镜像
backend/temp_*

# remotion-worker 模板构建产物（镜像内自行 npm install；基线/画廊 PNG 不入镜像）
video-templates/*/out/
video-templates/*/out-v2/
video-templates/*/.baseline-m0/
video-templates/*/build/
video-templates/*/node_modules/

# 构建加速临时项（构建后还原，不入提交）：本地测试产物/探针，从不被 COPY
test-output/
temp/
.zcode/
.agents/
