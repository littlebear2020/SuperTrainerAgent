{
  "mcpServers": {
    "metaso": {
      "enabled": true,
      "type": "http",
      "command": null,
      "args": [],
      "env": {},
      "url": "https://metaso.cn/api/mcp",
      "headers": {
        "Authorization": "Bearer $METASO_API_KEY"
      },
      "oauth": null,
      "description": "秘塔AI搜索 - 网页搜索、图片搜索、内容读取、智能问答"
    },
    "so_360_search_mcp": {
      "enabled": false,
      "type": "sse",
      "command": null,
      "args": [],
      "env": {},
      "url": "$SO_360_SEARCH_MCP_URL",
      "headers": {
        "Authorization": "Bearer $SO_360_SEARCH_MCP_KEY"
      },
      "oauth": null,
      "description": "360搜索 - 网页搜索(query必填搜索词, count可选每页结果数默认10)"
