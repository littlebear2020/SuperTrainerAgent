    "so_spider": {
      "enabled": false,
      "type": "sse",
      "command": null,
      "args": [],
      "env": {},
      "url": "$SO_SPIDER_MCP_URL",
      "headers": {
        "Authorization": "Bearer $SO_SPIDER_MCP_KEY"
      },
      "oauth": null,
      "description": "360搜索爬虫 - 通用网页抓取(crawler_360)、深度层级采集(depth_crawler_360)、小红书抓取(crawler_redbook_360)、视频采集(crawler_video_360)"
    },
    "zhitumcp": {
      "enabled": false,
      "type": "sse",
      "command": null,
      "args": [],
