# ── Docker 离线部署 (docker-compose-deploy.yaml) 必填 ─────────────────────
# 仅离线部署包需要；本地 make dev 不用管。
# 必须填部署目录的【绝对路径】（compose 用 :? 强制校验，缺失会拒绝启动）。
# 不要用 ${PWD}：sudo 启动 compose 时 PWD 被剥离，会静默拼成 /.deer-flow，
# 导致沙箱 bind mount 全部失败（见 docs/changelog-2026-07-20-sandbox-host-base-dir-pwd-fix.md）。
DEER_FLOW_HOST_BASE_DIR=/root/deerflow-deploy/.deer-flow
DEER_FLOW_HOST_SKILLS_PATH=/root/deerflow-deploy/skills

# ── Compose 服务群（quickstart / dev / deploy 共用）───────────────────────
# ppt-converter sidecar 共享密钥——compose `:?` 硬校验项；本地 docker.sh 会自动
# 生成到 docker/.ppt-converter-secret，服务器/手填场景用 .env 注入：
#PPT_CONVERTER_SECRET=  # 生成：openssl rand -hex 32
# 裸跑 gateway（不经 compose）时手动指认 worker 池探测地址；compose 内已有默认值
# （http://production-worker:8040 / http://remotion-worker:8040，见 worker_probe.py）：
#WORKER_HEALTH_URL=http://localhost:8040
#REMOTION_WORKER_HEALTH_URL=http://localhost:8040
# 以下为 compose 已定值的运行时档位（此处记录口径，裸跑可调）：
#FFMPEG_MAX_WORKERS=4              # gateway 内 ffmpeg 线程池（executors.py）
#GATEWAY_WORKERS=1                 # uvicorn 进程数——多 worker 破坏会话粘性（Run not found 404），勿调
#AUTH_TRUSTED_PROXIES=172.0.0.0/8  # 反代链可信网段（csrf/auth 取真实客户端 IP）
#GATEWAY_CORS_ORIGINS=             # 跨域白名单（逗号分隔）；同源反代部署无需设置

# ── 搜索 / 抓取 MCP ──────────────────────────────────────
# TAVILY_API_KEY is only needed if you uncomment the Tavily web_search tool in config.yaml
TAVILY_API_KEY=your-tavily-api-key

# MetaSo API Key (referenced as $METASO_API_KEY in extensions_config.json)
METASO_API_KEY=your-metaso-api-key

# 360 搜索 MCP (SSE, referenced as $SO_360_SEARCH_MCP_KEY/URL in extensions_config.json)
SO_360_SEARCH_MCP_KEY=your-so-360-search-mcp-key
SO_360_SEARCH_MCP_URL=https://api.360.cn/v1/mcp/key/<your-key>/sid/<your-sid>/sse

# 360 搜索爬虫 MCP (disabled by default)
SO_SPIDER_MCP_KEY=your-so-spider-mcp-key
SO_SPIDER_MCP_URL=https://api.360.cn/v1/mcp/key/<your-key>/toolkit/<your-toolkit>/sse

# 智图 AI MCP (disabled by default)
ZHIITU_MCP_KEY=your-zhitu-mcp-key
ZHIITU_MCP_URL=https://api.360.cn/v1/mcp/key/<your-key>/sid/<your-sid>/sse

# ── 360 API Key (external api.360.cn, LLM + image generation) ──
QIHU_API_KEY=your-qihu-api-key
#QIHU_BASE_URL=https://api.360.cn

# 技能密钥 AUTOBIND 默认关闭。开启后会把「启用技能 required-secrets 的声明并集
# （required/optional 均计入）∩ Gateway 进程 env 中有值的变量」注入沙箱；删除单个
# 技能的声明不会删除其他技能的同名声明。仅在审计过启用技能与 Gateway env 后开启。
#DEER_FLOW_SKILL_SECRET_AUTOBIND=1

# ── ByteDance Ark (Volcengine 方舟) — 生图 / 视频（Ark 通道保留）──
# 2026-10-12 花名册批：Ark 直连聊天模型 doubao-seed-2-1-pro-260628 已删册（聊天一律
# 走 360 通道）；本 key 仍服务 Ark 生图 doubao-seedream-5-0-pro-260628 / 生视频
# doubao-seedance-2-0-260128 及 video_gen.ark_api_key 兜底，勿删。
# 见 backend/docs/BYTEDANCE_MODELS_INTEGRATION_PLAN.md
ARK_API_KEY=your-ark-api-key

# ── ByteDance openspeech — TTS / 播客 / ASR (鉴权复用 config.yaml voice_clone.access_key) ──
# Stage 2a: seed-tts-2.0 预设音色 id (控制台购买音色后填; 未确认前 sandbox.environment 此行须注释,
# 因 resolve_env_variables 严格要求 env 存在, 缺失会阻塞 config 加载)
#DOUBAO_TTS_DEFAULT_SPEAKER=your-seed-tts-2.0-speaker-id
# Optional: /voices 白名单 — 只列出已开通的 doubao speaker (逗号分隔, 匹配 speaker id 部分).
# 未设 = access_key 存在时列出全部 doubao 音色; 设了 = 只列白名单内 (避免列出未开通→55000000 失败).
#DOUBAO_TTS_ENABLED_SPEAKERS=zh_female_vv_uranus_bigtts,zh_male_m191_uranus_bigtts
# Stage 3: 播客双人音色 (控制台确认后填; 退化方案用 seed-tts-2.0 逐句合成, 同样卡 speaker)
#VOLCENGINE_PODCAST_APP_ID=your-podcast-app-id
#VOLCENGINE_PODCAST_ACCESS_KEY=your-podcast-access-key
#DOUBAO_PODCAST_SPEAKER_MALE=zh_male_dayixiansheng_v2_saturn_bigtts
#DOUBAO_PODCAST_SPEAKER_FEMALE=zh_female_mizaitongxue_v2_saturn_bigtts
# Stage 6: openspeech ASR 直连 (控制台核对 endpoint 后填; 可复用 voice_clone.access_key)
#ASR_VOLC_API_KEY=your-openspeech-asr-api-key

# ── 360 preset TTS voice ids (podcast-generation / daily-news-broadcast) ──
# REMOVED (2026-07): ZYUN_API_KEY, ZYUN_TTS_BASE_URL, COSYVOICE_* — migrated to
# QIHU_API_KEY + 360 preset TTS. See docs/superpowers/specs/2026-07-06-model-consolidation-360-zhinao-design.md
# Defaults: male preset:332 (磁性解说男声), female preset:158 (知性温婉) — confirmed
# accepted by the 360 API (backend/scripts/model_connectivity_check.py).
# REMOVED (2026-10-05 审计 §12-8): QIHU_TTS_MALE_VOICE_ID / QIHU_TTS_FEMALE_VOICE_ID /
# QIHU_TTS_TIMEOUT —— 后端零消费（全仓 grep 无读取点），保留注释防复活。
#QIHU_TTS_MALE_VOICE_ID=332
#QIHU_TTS_FEMALE_VOICE_ID=158
#QIHU_TTS_TIMEOUT=120
# QIHU_TTS_SPEED_ATEMPO=  # 置 1 = 360 TTS 速度走 ffmpeg atempo 后处理；缺省走 360 API 级 speed 参数（若实测 API 忽略 speed 则置 1）

# ── InfoQuest API Key (only needed if you uncomment InfoQuest tools in config.yaml) ──
INFOQUEST_API_KEY=your-infoquest-api-key

# CORS Origins (comma-separated) - e.g., http://localhost:3000,http://localhost:3001
#CORS_ORIGINS=http://localhost:3000

# ── ZhiPu Coding Plan API Key (GLM-5.1, GLM-5-Turbo) ──
# 作用域注意：gateway 主进程不消费此 key——实际消费在 skills/public/ppt-master/
# 沙箱环境（SKILL.md 声明 + scripts/image_gen.py 直读）。
ZHIPU_API_KEY=your-zhipu-api-key

# ── Optional LLM Providers ──
# FIRECRAWL_API_KEY=your-firecrawl-api-key
# VOLCENGINE_API_KEY=your-volcengine-api-key
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key
# NOVITA_API_KEY=your-novita-api-key
# VLLM_API_KEY=your-vllm-api-key

# ── IM Channels ──
# AES-256-GCM key for encrypting user channel credentials (32-byte hex).
# Generate with: python -c 'import os; print(os.urandom(32).hex())'
#CREDENTIAL_ENCRYPTION_KEY=your-32-byte-hex-key
#FEISHU_APP_ID=your-feishu-app-id
#FEISHU_APP_SECRET=your-feishu-app-secret
# SLACK_BOT_TOKEN=your-slack-bot-token
# SLACK_APP_TOKEN=your-slack-app-token
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# DISCORD_BOT_TOKEN=your-discord-bot-token
# WECOM_BOT_ID=your-wecom-bot-id
# WECOM_BOT_SECRET=your-wecom-bot-secret
# DINGTALK_CLIENT_ID=your-dingtalk-client-id
# DINGTALK_CLIENT_SECRET=your-dingtalk-client-secret

# ── Langfuse Self-Hosted Tracing ──
LANGFUSE_TRACING=true
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_BASE_URL=http://localhost:3099
# 自托管基础设施口令（docker-compose.langfuse.yaml `:?` 硬校验，2026-10-05 C3；
# 生成：openssl rand -hex 16。已有数据卷换口令的兼容注意见该 compose 头注释）：
#LANGFUSE_POSTGRES_PASSWORD=
#LANGFUSE_CLICKHOUSE_PASSWORD=
#LANGFUSE_MINIO_ROOT_PASSWORD=
#LANGFUSE_NEXTAUTH_SECRET=

# LangSmith（可选 tracing 后端；TrainerAI 默认用上方 Langfuse）
# 由 deerflow tracing_config.py 直读 env（LANGSMITH_/LANGCHAIN_ 双前缀兼容），
# 仅显式置 LANGSMITH_TRACING=true 时需要，默认无需配置：
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=your-langsmith-project

# ── GitHub (deep research, rate limit boost) ──
#GITHUB_TOKEN=your-github-token

# ── Database (only needed when config.yaml has database.backend: postgres) ──
# DATABASE_URL=postgresql://deerflow:password@localhost:5432/deerflow

# ── Gateway ──
# Set to "false" to disable Swagger UI, ReDoc, and OpenAPI schema in production
#GATEWAY_ENABLE_DOCS=false

# Auth JWT Secret (persistent - prevents session invalidation on restart)
AUTH_JWT_SECRET=your-auth-jwt-secret

# ── ACP Agent (Claude Code) ──
#ANTHROPIC_AUTH_TOKEN=your-anthropic-auth-token
#ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# ── Voice Clone (Volcengine) ──
# Required when voice_clone.enabled=true in config.yaml
#VOLCENGINE_VOICE_APPID=your-volcengine-voice-appid
#VOLCENGINE_VOICE_TOKEN=your-volcengine-voice-token
# config.yaml voice_clone 段以 $VOLCENGINE_VOICE_ACCESS_KEY 引用（openspeech
# 鉴权复用同一凭证）；缺失时 config 加载 fail-fast：
#VOLCENGINE_VOICE_ACCESS_KEY=your-volcengine-access-key

# Video Gen / Voice Twin — edge-tts 是付费引擎全挂时的兜底安全网。
# 公司服务器实测 edge 直连可达（不稳定但可用），**不建议**设此变量。
# 设 1 仅影响 video-gen 侧；voice-twin 降级链由 config.yaml edge_tts.enabled 独立控制。
#TTS_DISABLE_EDGE_FALLBACK=1
