{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/env.js",
    "src/**/index.ts"
  ],
  "project": ["src/**/*.{ts,tsx,mts,jsx}"],
  "ignore": ["tests/**", "e2e/**", ".superpowers/**"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["tailwindcss", "tw-animate-css"],
  "include": ["exports", "dependencies"],
  "ignoreIssues": {
    "src/components/ui/**": ["exports"],
    "src/components/ai-elements/**": ["exports"]
  }
}
